# marianoguerra/llm — every variable this module reads.
#
# Nothing here loads a .env file: the module reads real environment variables
# through `@env.get_env_var`, by the NAMES a `ProviderSpec` carries. So this
# is a file to copy and source, not one anything picks up on its own:
#
#     cp .env.example .env
#     set -a; . ./.env; set +a
#     just smoke
#
# Every line is commented out on purpose. An empty value is NOT the same as an
# unset one — `ANTHROPIC_API_KEY=` makes the provider look CONFIGURED with a
# blank credential, so `just smoke` will try it and collect a 401 instead of
# skipping it. Set a variable to a real value or leave it out entirely.
#
# Keep .env out of git. It is in .gitignore for that reason.


# ── Credentials ───────────────────────────────────────────────────────────
#
# Each of these turns ONE provider on. Setting it means:
#   • `@wire.configured(registry)` lists that provider, so `just smoke`
#     exercises it — providers without a key are skipped, never failed;
#   • `@wire.key_of` and `@wire.endpoint_for` can resolve a call to it.
#
# The registry only ever holds the NAME of the variable, never its value,
# which is what lets the same registry compile into a browser page.

# OpenAI — the `openai-responses` protocol. Default model: gpt-5.6-sol.
# `just smoke` uses gpt-5-nano instead, as the cheapest one it lists.
#OPENAI_API_KEY=sk-...

# Anthropic — `anthropic-messages`. Default model: claude-sonnet-5.
# `just smoke` uses claude-haiku-4-5.
#ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini — `google-generative-ai`, the one whose endpoint carries the
# model and whose key travels as a `?key=` query parameter rather than a
# header. Default model: gemini-3.8-flash. `just smoke` uses
# gemini-2.5-flash-lite.
#GEMINI_API_KEY=...

# OpenRouter — the `openrouter` protocol, which borrows the chat-completions
# mapping. Default model: openai/gpt-5.4-mini, which `just smoke` also uses.
#OPENROUTER_API_KEY=sk-or-...

# Cerebras — plain `openai-completions`, no dialect of its own. Serves two
# models; both default and `just smoke` use gpt-oss-120b.
#CEREBRAS_API_KEY=csk-...


# ── Model overrides ───────────────────────────────────────────────────────
#
# Each of these changes which model `@wire.model_of(spec)` — and so
# `@wire.from_env` — picks for that ONE provider. Unset means the provider's
# own `default_model`.
#
# Deliberately per-provider: there is no global "use this model" variable,
# because applying one provider's model to another is how a Gemini call goes
# out asking for `models/gpt-5.4-mini`.
#
# NOTE: `just smoke` ignores these. It picks each provider's cheapest listed
# model on purpose, so that a run stays worth repeating; overriding the model
# there would be overriding the point.

#LLM_OPENAI_MODEL=gpt-5.6-sol
#LLM_ANTHROPIC_MODEL=claude-sonnet-5
#LLM_GEMINI_MODEL=gemini-3.8-flash
#LLM_OPENROUTER_MODEL=openai/gpt-5.4-mini
#LLM_CEREBRAS_MODEL=gpt-oss-120b


# ── What is NOT a variable here ───────────────────────────────────────────
#
# `@wire.from_env` also takes a `provider_env` and a `model_env` — "which
# provider should this run use at all", and its model. Those are ARGUMENTS,
# not constants: the embedding application names them, and this module is
# meant to outlive any one spelling.
#
# Note the asymmetry with the LLM_*_MODEL names above. Those are carried by a
# `ProviderSpec`, so they are this module's and it reads them. These two are
# not carried by anything — whatever your application passes is the name, and
# nothing in this repo reads it. They are spelled MYAPP_ below to keep that
# clear rather than LLM_, which would suggest otherwise.
#
# So if your application calls:
#
#     @wire.from_env(registry, priority=["anthropic", "openai"],
#                    provider_env="MYAPP_PROVIDER", model_env="MYAPP_MODEL")
#
# ...then these are yours to document:
#
#MYAPP_PROVIDER=anthropic
#MYAPP_MODEL=claude-sonnet-5
